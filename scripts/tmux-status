#!/bin/sh
# Quiet right-side status text: branch, AWS profile, directory, battery, clock.
# The HomeLab stays plugged in, so its battery sits at 100%. Skip it.
# The clock is omitted when this client was opened from another tmux, so the
# outer bar is the only one showing the time.
path=$1
client_pid=$2
parts=

add() {
	[ -n "$1" ] || return 0
	if [ -n "$parts" ]; then
		parts="$parts  $1"
	else
		parts=$1
	fi
}

branch=$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=
add "$branch"

add "${AWS_PROFILE:-}"

# Home's directory name is the login name. Skip it.
if [ "$path" != "$HOME" ]; then
	add "$(basename "$path")"
fi

# HomeLab stays on AC at 100%, so skip it. Linux laptops expose sysfs.
# Android restricts sysfs; use Termux:API there. macOS uses pmset.
# A desktop with none of these sources adds nothing.
if [ "$(hostname -s 2>/dev/null)" != ubuntu ]; then
	cap=
	st=
	if [ -d /sys/class/power_supply ]; then
		cap=$(awk 'NR==1 { print; exit }' /sys/class/power_supply/BAT*/capacity 2>/dev/null) || cap=
		st=$(awk 'NR==1 { print; exit }' /sys/class/power_supply/BAT*/status 2>/dev/null) || st=
	fi
	if [ -z "$cap" ] && [ -n "${TERMUX_VERSION:-}${PREFIX:-}" ] && command -v termux-battery-status >/dev/null 2>&1; then
		# Killing a Termux:API client closes its reply socket before Android
		# can return the result. Read a cache and let one detached poll finish.
		cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/tmux
		if command -v flock >/dev/null 2>&1; then
			(
				umask 077
				mkdir -p "$cache_dir" || exit
				exec 9>"$cache_dir/battery.lock"
				flock -n 9 || exit
				now=$(date +%s)
				last=0
				read -r last < "$cache_dir/battery.polled" || last=0
				case $last in ''|*[!0-9]*) last=0 ;; esac
				[ "$((now - last))" -ge 60 ] || exit
				printf '%s\n' "$now" > "$cache_dir/battery.polled"
				if termux-battery-status > "$cache_dir/battery.tmp"; then
					mv "$cache_dir/battery.tmp" "$cache_dir/battery.json"
				else
					rm -f "$cache_dir/battery.tmp"
				fi
			) </dev/null >/dev/null 2>&1 &
		fi
		batt=$(cat "$cache_dir/battery.json" 2>/dev/null) || batt=
		cap=$(printf '%s\n' "$batt" | sed -n 's/^[[:space:]]*"percentage":[[:space:]]*\([0-9][0-9]*\),\{0,1\}[[:space:]]*$/\1/p')
		st=$(printf '%s\n' "$batt" | sed -n 's/^[[:space:]]*"status":[[:space:]]*"\([^"]*\)".*$/\1/p')
	fi
	if [ -z "$cap" ] && command -v pmset >/dev/null 2>&1; then
		batt=$(pmset -g batt 2>/dev/null) || batt=
		cap=$(printf '%s\n' "$batt" | sed -n 's/.*InternalBattery.*[[:space:]]\([0-9][0-9]*\)%;.*/\1/p' | head -n 1)
		st=$(printf '%s\n' "$batt" | sed -n 's/.*InternalBattery.*;[[:space:]]*\([^;]*\);.*/\1/p' | head -n 1)
	fi
	if [ -n "$cap" ]; then
		mark=
		case $st in
			Charging|CHARGING|charging|"finishing charge") mark=+ ;;
		esac
		add "${cap}%${mark}"
	fi
fi

nested=0
pid=$client_pid
i=0
while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$i" -lt 6 ]; do
	# /proc/PID/environ is NUL-separated. A line-oriented read only sees the first variable.
	term=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | awk -F= '$1=="TERM" { print $2; exit }') || term=
	case $term in
		tmux*) nested=1; break ;;
	esac
	pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
	i=$((i + 1))
done

if [ "$nested" -eq 0 ]; then
	add "$(date '+%a %-d %b %H:%M')"
fi

[ -n "$parts" ] && printf '%s  ' "$parts"
